{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "ui/*": [
        "./src/ui/*"
      ],
      "features/*": [
        "./src/features/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "services/*": [
        "./src/services/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "styles/*": [
        "./src/styles/*"
      ],
      "context/*": [
        "./src/context/*"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "starter",
    "**/App-v*.tsx",
    "**/*-memo.tsx",
    "**/src-no-context/**",
    "**/starter.ts"
  ]
}
